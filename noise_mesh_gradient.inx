<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Noise Mesh Gradient</name>
    <id>org.example.noise_mesh</id>
    <label>Select a gradient-filled object first, then apply.</label>
    <param name="rows" type="int" gui-text="Rows" min="1" max="100">4</param>
    <param name="cols" type="int" gui-text="Columns" min="1" max="100">4</param>
    <param name="noise_scale" type="float" min="0.001" max="100" gui-text="Noise Scale (Smaller = smoother)">1.1</param>
    <param name="seed" type="int" min="1" max="2147483647" gui-text="Noise Seed">42</param>
    <param name="noise_type" type="optiongroup" appearance="combo"
       gui-text="Noise type">
        <option value="simplex">Simplex</option>
        <option value="fbm">FBM (fractal)</option>
        <option value="turbulence">Turbulence</option>
    </param>
    <param name="octaves" type="int" min="1" max="8" gui-text="Octaves (Number of noise layers stacked for FBM / Turbulence)">4</param>
    <param name="lacunarity" type="float" min="1.5" max="4" gui-text="Lacunarity (Frequency multiplier between octaves for FBM / Turbulence)">2.0</param>
    <param name="gain" type="float" min="0.1" max="0.9" gui-text="Gain (Amplitude decay between octaves for FBM / Turbulence)">0.5</param>
    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Render"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">noise_mesh_gradient.py</command>
    </script>
</inkscape-extension>